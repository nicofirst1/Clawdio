{
  "_comment": "Claudio (formerly claude-geiger / agent-sonifier) hooks block. Schema confirmed against https://code.claude.com/docs/en/hooks on 2026-08-02: top-level 'hooks' object keyed by event name, each entry a list of {matcher, hooks:[{type:'command', command, timeout, async}]}. For tool-scoped events (PreToolUse/PostToolUse/PostToolUseFailure) matcher '*' means match-all per the docs' matcher-patterns table ('*', '' or omitted all mean match all). For events documented as not supporting matchers at all (SessionStart/SessionEnd/Stop/UserPromptSubmit/Notification/PermissionRequest/PreCompact/SubagentStart/SubagentStop) the matcher key is omitted entirely -- the docs say a matcher on those is silently ignored anyway, so omitting is the correct/canonical form. Merge this 'hooks' object into your ~/.claude/settings.json (or run install.sh, which does it for you with a .bak backup). All commands are 'async': true so the audio side-channel never blocks a tool call, permission decision, or turn -- send-event.sh itself is also independently non-blocking (bounded by its own 1s internal timeout plus this 2s hook timeout as a hard ceiling). CLAUDIO_PORT/CLAUDIO_HOST are read from your shell env by send-event.sh if exported in settings.json 'env', else default to 127.0.0.1:9753.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/autostart-daemon.sh",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/send-event.sh",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/send-event.sh",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/send-event.sh",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/send-event.sh",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/send-event.sh",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/send-event.sh",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/send-event.sh",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/send-event.sh",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/send-event.sh",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/send-event.sh",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/send-event.sh",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/send-event.sh",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ]
  }
}
